# Run `docker compose port postgres 5432` and replace <assigned-port>.
DATABASE_URL=postgresql://sharons:sharons_dev_password@127.0.0.1:<assigned-port>/sharons_dev
SHARONS_SECRET_KEY=change-me
SHARONS_DEBUG=1
SHARONS_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave these empty until you create the credentials. Do not commit real values.
SHARONS_GITHUB_TOKEN=
SHARONS_GMAIL_TOKEN=
SHARONS_GMAIL_REFRESH_TOKEN=
SHARONS_GMAIL_CLIENT_ID=
SHARONS_GMAIL_CLIENT_SECRET=
